Thumbs.db

# Logs, caches, dependencies, and build output
*.log
tmp/
temp/
.cache/
coverage/
dist/
build/
node_modules/
vendor/

# Documentation and CI files are normally unnecessary in image contexts
docs/
*.md
!README.md
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
.dockerignore
